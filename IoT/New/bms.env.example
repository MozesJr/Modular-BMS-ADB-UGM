# Copy ke bms.env, lalu: chmod 600 bms.env
MQTT_BROKER_HOST=72.61.208.150
MQTT_BROKER_PORT=1883
MQTT_USERNAME=esp32_device
MQTT_PASSWORD=ganti_dengan_password_baru

DEVICE_ID=GAMA-BMS-PACK-001
PUBLISH_INTERVAL=10

# 1 JK-BMS = 1 pack. Lebih dari satu BMS: pisahkan dengan koma, urutan = index pack
SERIAL_PORTS=/dev/serial0
BMS_BAUDRATE=115200
BMS_REQUEST_INTERVAL=2
BMS_DEBUG=0
