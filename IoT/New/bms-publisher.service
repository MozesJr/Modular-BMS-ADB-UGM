[Unit]
Description=JK-BMS to MQTT publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/bms
EnvironmentFile=/home/pi/bms/bms.env
ExecStart=/usr/bin/python3 /home/pi/bms/bms_publisher.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
