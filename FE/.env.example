# FE/.env.example — development (cp jadi .env.local)
BACKEND_URL=http://localhost:4000
# Harus sama persis dengan NEXTAUTH_SECRET di BE/.env
NEXTAUTH_SECRET=replace-with-same-secret-as-BE
# Browser connect langsung ke WS backend (Next rewrites gak bisa proxy WS upgrade).
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
