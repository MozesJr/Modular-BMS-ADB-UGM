# FE/.env.production.example — cp jadi FE/.env.production di VPS, isi lalu jangan commit.
#
# BACKEND_URL dipakai DUA kali:
#   1. Saat build image (docker-compose.yml -> build.args.BACKEND_URL) untuk rewrites() Next.js
#      (output:"standalone" -> rewrites dievaluasi saat build, bukan runtime).
#   2. Di sini, sebagai runtime env — nilainya harus SAMA dengan build arg di FE/docker-compose.yml.
# Default "http://backend:4000" = nama service "backend" di bms-network (internal Docker network),
# tidak perlu diganti kecuali nama service backend berubah.
BACKEND_URL=http://backend:4000

# Harus sama persis dengan NEXTAUTH_SECRET di BE/.env.production
NEXTAUTH_SECRET=replace-with-same-secret-as-BE
