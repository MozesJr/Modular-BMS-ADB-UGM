flowchart LR
  classDef ent fill:#ffffff,stroke:#1f2937,stroke-width:2px,color:#1f2937,font-weight:bold
  classDef hw fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#1f2937
  classDef svc fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#1f2937
  classDef db fill:#f0fdfa,stroke:#0d9488,stroke-width:2px,color:#1f2937
  classDef cl fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#1f2937
  classDef planned fill:#f9fafb,stroke:#9ca3af,stroke-dasharray:6 4,color:#6b7280

  Pi["Raspberry Pi"]:::hw
  Browser["Browser User"]:::cl
  Mobile["Aplikasi Mobile<br/>(planned)"]:::planned
  GH["GitHub Actions<br/>CI + deploy"]:::ent

  subgraph VPS["VPS · Docker Compose"]
    direction LR
    NPM["Nginx Proxy Manager<br/>gamabms.tech"]:::svc
    subgraph BMS["bms-network"]
      direction LR
      FE["bms-frontend<br/>Next.js :3001"]:::svc
      BE["bms-backend<br/>Next.js + WS :4000"]:::svc
      MQ["bms-mqtt<br/>Mosquitto :1883"]:::svc
    end
    subgraph MDB["master-db-network (stack terpisah)"]
      PG[("master_postgresql")]:::db
    end
  end

  Browser -- "HTTP(S)" --> NPM
  NPM -- "/" --> FE
  NPM -- "/ws" --> BE
  FE -- "rewrites /api/*" --> BE
  Pi -- "MQTT 1883" --> MQ
  Pi -. "MQTT TLS 8883 (planned)" .-> MQ
  MQ -- "subscribe" --> BE
  BE -- "Prisma" --> PG
  Mobile -. "API v1 (bearer)" .-> NPM
  GH -- "SSH: build, migrate, up" --> VPS
