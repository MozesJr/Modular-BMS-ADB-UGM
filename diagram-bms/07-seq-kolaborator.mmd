sequenceDiagram
  autonumber
  actor O as Owner
  participant FE as Frontend<br/>DeviceDetail
  participant API as FE lib/api.ts
  participant BE as Backend<br/>/devices/[id]/collaborators
  participant AZ as assertOwner()
  participant DB as PostgreSQL

  O->>FE: isi modal undang (email, role)
  FE->>API: submit
  API->>BE: POST /api/backend/devices/{id}/collaborators
  BE->>AZ: cek pemilik device
  AZ->>DB: SELECT Device.ownerId
  DB-->>AZ: owner cocok
  BE->>DB: cari User by email
  DB-->>BE: user ditemukan
  BE->>DB: INSERT DeviceCollaborator
  DB-->>BE: sukses
  BE-->>API: 200 + data kolaborator
  API-->>FE: refresh daftar
  FE-->>O: kolaborator tampil
