erDiagram
  direction LR
  USER ||--o{ DEVICE : "memiliki"
  USER ||--o{ DEVICE_COLLABORATOR : "berkolaborasi"
  DEVICE ||--o{ DEVICE_COLLABORATOR : "dibagikan ke"
  USER ||--o{ PASSWORD_RESET_TOKEN : "punya"
  USER ||--o{ REFRESH_TOKEN : "punya"
  DEVICE ||--o{ PACK : "state terkini"
  PACK ||--o{ CELL : "berisi"
  DEVICE ||--o{ PACK_HISTORY : "time-series"
  DEVICE ||--o{ CELL_HISTORY : "time-series"
  DEVICE ||--o{ PACK_ROLLUP_1M : "rollup"
  DEVICE ||--o{ CELL_ROLLUP_1M : "rollup"

  USER {
    string id PK
    string email UK
    string passwordHash
    Role role "USER | ADMIN"
    int tokenVersion
  }
  DEVICE {
    string id PK
    string serialNumber UK
    string ownerId FK "nullable"
    boolean verified
    datetime lastSeen
  }
  DEVICE_COLLABORATOR {
    string id PK
    string deviceId FK
    string userId FK
    string role "viewer | editor"
  }
  PASSWORD_RESET_TOKEN {
    string id PK
    string userId FK
  }
  REFRESH_TOKEN {
    string id PK
    string userId FK
  }
  PACK {
    string id PK
    string deviceId FK
    int index
    float temperature
    float current
    float power
  }
  CELL {
    string id PK
    string packId FK
    int index
    float voltage
  }
  PACK_HISTORY {
    string id PK
    string deviceId FK
    int packIndex
    datetime recordedAt
  }
  CELL_HISTORY {
    string id PK
    string deviceId FK
    int packIndex
    int cellIndex
    datetime recordedAt
  }
  PACK_ROLLUP_1M {
    string deviceId FK "composite PK"
  }
  CELL_ROLLUP_1M {
    string deviceId FK "composite PK"
  }
