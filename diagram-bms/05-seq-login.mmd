sequenceDiagram
  autonumber
  actor U as User
  participant FE as Frontend<br/>SignInForm
  participant PX as FE rewrite<br/>/api/auth/*
  participant BE as Backend<br/>Auth.js
  participant CR as credentials.ts
  participant DB as PostgreSQL

  U->>FE: isi email & password
  FE->>PX: signIn("credentials")
  PX->>BE: POST /api/auth/callback/credentials
  BE->>CR: verifyCredentials()
  CR->>DB: SELECT User WHERE email
  DB-->>CR: user + passwordHash
  CR->>CR: bcrypt.compare()
  CR-->>BE: user valid (id, role)
  BE-->>FE: Set-Cookie session JWT
  FE-->>U: redirect ke Fleet Dashboard
