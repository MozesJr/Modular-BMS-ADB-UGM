# Root .env — hanya berisi MASTER_DB_NETWORK (nama, bukan secret) tapi tetap jangan di-commit
# supaya nilai per-VPS tidak ketimpa oleh nilai default di repo.
.env
.env.production
.env.local
.DS_Store

# hasil curl -c / cookie jar lokal: jangan pernah di-commit
cookies*.txt
*.credentials

# simulator dev lokal dijalankan langsung di host (bukan cuma via Docker) saat testing —
# node_modules/lockfile-nya tidak perlu ikut repo (Dockerfile sudah build sendiri).
tools/simulator/node_modules/
tools/simulator/package-lock.json
