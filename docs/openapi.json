{
  "openapi": "3.0.3",
  "info": {
    "title": "Modular Universal BMS API",
    "version": "1.0.0",
    "description": "API backend untuk aplikasi mobile dan web. Panduan lengkap: docs/API-GUIDE.md.\n\nKonvensi: base path `/api/v1`; waktu ISO-8601 UTC; satuan ada di nama field (voltageV, currentA, powerW, temperatureC, cellDeltaMv);\nerror seragam `{ error: { code, message, details? }, requestId }`; tidak ada SoC/SoH (belum ada di payload perangkat)."
  },
  "servers": [
    {
      "url": "https://YOUR-HOST",
      "description": "Ganti dengan origin publik backend (HTTPS wajib untuk build rilis mobile)"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Token akses + refresh dengan rotasi"
    },
    {
      "name": "Akun",
      "description": "Profil user"
    },
    {
      "name": "Device",
      "description": "Daftar dan detail device, klaim, ubah nama, lepas/hapus"
    },
    {
      "name": "Riwayat",
      "description": "Time-series (raw atau agregat)"
    },
    {
      "name": "Collaborator",
      "description": "Berbagi akses device (viewer/editor)"
    },
    {
      "name": "Dashboard",
      "description": "Ringkasan lintas device"
    },
    {
      "name": "Operasional",
      "description": "Health check"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token dari POST /api/v1/auth/login atau /refresh."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "down",
              "shutting_down"
            ]
          },
          "uptimeSec": {
            "type": "integer"
          },
          "db": {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "latencyMs": {
                "type": "integer",
                "nullable": true
              }
            },
            "required": [
              "ok",
              "latencyMs"
            ]
          },
          "mqtt": {
            "type": "object",
            "properties": {
              "connected": {
                "type": "boolean"
              },
              "lastMessageAt": {
                "type": "string",
                "nullable": true,
                "format": "date-time",
                "example": "2026-09-21T08:15:00.000Z"
              },
              "lastMessageAgeSec": {
                "type": "integer",
                "nullable": true
              }
            },
            "required": [
              "connected",
              "lastMessageAt",
              "lastMessageAgeSec"
            ]
          },
          "ingest": {
            "type": "object",
            "properties": {
              "queueDepth": {
                "type": "integer"
              }
            },
            "required": [
              "queueDepth"
            ]
          },
          "counters": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "status",
          "uptimeSec",
          "db",
          "mqtt",
          "ingest",
          "counters"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "DEVICE_NOT_FOUND",
                "description": "Kode stabil untuk mesin; jangan mem-branch pada `message`."
              },
              "message": {
                "type": "string",
                "description": "Pesan untuk manusia (bahasa Indonesia)."
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ErrorIssue"
                },
                "description": "Hanya untuk VALIDATION_ERROR: daftar isu per field."
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "requestId": {
            "type": "string",
            "description": "Sama dengan header X-Request-Id; sertakan saat melaporkan masalah."
          }
        },
        "required": [
          "error",
          "requestId"
        ]
      },
      "ErrorIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT, kirim sebagai `Authorization: Bearer …`. Simpan HANYA di memori."
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque, sekali pakai (rotasi). Simpan di Keychain/Keystore."
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "description": "Umur access token dalam detik.",
            "example": 900
          },
          "refreshExpiresIn": {
            "type": "integer",
            "description": "Umur refresh token dalam detik.",
            "example": 2592000
          },
          "user": {
            "$ref": "#/components/schemas/Me"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn",
          "refreshExpiresIn",
          "user"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "expiresAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2026-09-21T08:15:00.000Z",
            "description": "Akun berakhir pada waktu ini; null = tidak pernah."
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "expiresAt"
        ]
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "USER",
          "ADMIN"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "deviceName": {
            "type": "string",
            "maxLength": 100,
            "description": "Nama perangkat (mis. 'Pixel 8'), ditampilkan di daftar sesi."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "DeviceListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceListItem"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Kirim sebagai ?cursor= untuk halaman berikutnya; null = habis."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "DeviceListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "serialNumber": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "verified": {
            "type": "boolean",
            "description": "Sudah disetujui admin."
          },
          "role": {
            "$ref": "#/components/schemas/DeviceRole"
          },
          "owner": {
            "$ref": "#/components/schemas/DeviceOwner"
          },
          "online": {
            "type": "boolean",
            "description": "Ada data dalam batas waktu online (default 180 dtk)."
          },
          "lastSeenAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2026-09-21T08:15:00.000Z",
            "description": "Waktu server menerima data terakhir."
          },
          "packCount": {
            "type": "integer"
          },
          "summary": {
            "$ref": "#/components/schemas/DeviceStats"
          }
        },
        "required": [
          "id",
          "serialNumber",
          "name",
          "verified",
          "role",
          "owner",
          "online",
          "lastSeenAt",
          "packCount"
        ]
      },
      "DeviceRole": {
        "type": "string",
        "enum": [
          "owner",
          "editor",
          "viewer"
        ],
        "description": "Peran user yang sedang login pada device ini."
      },
      "DeviceOwner": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "DeviceStats": {
        "type": "object",
        "properties": {
          "packs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackSummary"
            }
          },
          "maxTemperatureC": {
            "type": "number",
            "nullable": true
          },
          "maxCellDeltaMv": {
            "type": "number",
            "nullable": true
          },
          "totalPowerW": {
            "type": "number",
            "nullable": true
          },
          "minCellVoltageV": {
            "type": "number",
            "nullable": true
          },
          "maxCellVoltageV": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "packs",
          "maxTemperatureC",
          "maxCellDeltaMv",
          "totalPowerW",
          "minCellVoltageV",
          "maxCellVoltageV"
        ],
        "description": "Ada bila view=summary."
      },
      "PackSummary": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "voltageV": {
            "type": "number",
            "nullable": true,
            "description": "Jumlah tegangan seluruh cell pack (V)."
          },
          "currentA": {
            "type": "number",
            "nullable": true,
            "description": "Ampere; NEGATIF = charging, positif = discharging."
          },
          "powerW": {
            "type": "number",
            "nullable": true
          },
          "temperatureC": {
            "type": "number",
            "nullable": true,
            "description": "null = sensor error / tidak ada pembacaan."
          },
          "cellDeltaMv": {
            "type": "number",
            "nullable": true,
            "description": "Selisih cell tertinggi − terendah (mV)."
          },
          "cellCount": {
            "type": "integer"
          }
        },
        "required": [
          "index",
          "voltageV",
          "currentA",
          "powerW",
          "temperatureC",
          "cellDeltaMv",
          "cellCount"
        ]
      },
      "DeviceDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "serialNumber": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "verified": {
            "type": "boolean",
            "description": "Sudah disetujui admin."
          },
          "role": {
            "$ref": "#/components/schemas/DeviceRole"
          },
          "owner": {
            "$ref": "#/components/schemas/DeviceOwner"
          },
          "online": {
            "type": "boolean",
            "description": "Ada data dalam batas waktu online (default 180 dtk)."
          },
          "lastSeenAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2026-09-21T08:15:00.000Z",
            "description": "Waktu server menerima data terakhir."
          },
          "packCount": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-21T08:15:00.000Z"
          },
          "summary": {
            "$ref": "#/components/schemas/DeviceStats"
          },
          "packs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackDetail"
            }
          },
          "collaborators": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Collaborator"
            }
          }
        },
        "required": [
          "id",
          "serialNumber",
          "name",
          "verified",
          "role",
          "owner",
          "online",
          "lastSeenAt",
          "packCount",
          "createdAt",
          "summary",
          "packs",
          "collaborators"
        ]
      },
      "PackDetail": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "temperatureC": {
            "type": "number",
            "nullable": true
          },
          "balancerConnected": {
            "type": "boolean"
          },
          "currentA": {
            "type": "number",
            "nullable": true
          },
          "powerW": {
            "type": "number",
            "nullable": true
          },
          "voltageV": {
            "type": "number",
            "nullable": true
          },
          "cellDeltaMv": {
            "type": "number",
            "nullable": true
          },
          "recordedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2026-09-21T08:15:00.000Z",
            "description": "Waktu efektif data (jam device bila wajar, selain itu waktu server)."
          },
          "receivedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2026-09-21T08:15:00.000Z",
            "description": "Waktu server menerima data."
          },
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cell"
            }
          }
        },
        "required": [
          "index",
          "temperatureC",
          "balancerConnected",
          "currentA",
          "powerW",
          "voltageV",
          "cellDeltaMv",
          "recordedAt",
          "receivedAt",
          "cells"
        ]
      },
      "Cell": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "voltageV": {
            "type": "number"
          }
        },
        "required": [
          "index",
          "voltageV"
        ]
      },
      "Collaborator": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true,
            "description": "Hanya terisi bila peminta adalah OWNER device; selain itu null."
          },
          "role": {
            "$ref": "#/components/schemas/CollaboratorRole"
          },
          "addedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-21T08:15:00.000Z"
          }
        },
        "required": [
          "userId",
          "name",
          "email",
          "role",
          "addedAt"
        ]
      },
      "CollaboratorRole": {
        "type": "string",
        "enum": [
          "viewer",
          "editor"
        ]
      },
      "DashboardSummary": {
        "type": "object",
        "properties": {
          "deviceCount": {
            "type": "integer"
          },
          "onlineCount": {
            "type": "integer"
          },
          "offlineCount": {
            "type": "integer"
          },
          "pendingVerificationCount": {
            "type": "integer"
          },
          "totalPowerW": {
            "type": "number",
            "nullable": true,
            "description": "Jumlah daya pack pada device ONLINE; negatif = net charging."
          },
          "maxTemperatureC": {
            "type": "number",
            "nullable": true
          },
          "maxCellDeltaMv": {
            "type": "number",
            "nullable": true
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-21T08:15:00.000Z"
          }
        },
        "required": [
          "deviceCount",
          "onlineCount",
          "offlineCount",
          "pendingVerificationCount",
          "totalPowerW",
          "maxTemperatureC",
          "maxCellDeltaMv",
          "generatedAt"
        ]
      },
      "HistoryResponse": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-21T08:15:00.000Z"
          },
          "to": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-21T08:15:00.000Z"
          },
          "bucket": {
            "$ref": "#/components/schemas/HistoryBucket"
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistorySeries"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Hanya untuk bucket=raw; null = habis."
          }
        },
        "required": [
          "deviceId",
          "from",
          "to",
          "bucket",
          "series",
          "nextCursor"
        ]
      },
      "HistoryBucket": {
        "type": "string",
        "enum": [
          "raw",
          "1m",
          "5m",
          "1h"
        ]
      },
      "HistorySeries": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "pack",
              "cell"
            ]
          },
          "packIndex": {
            "type": "integer"
          },
          "cellIndex": {
            "type": "integer",
            "nullable": true,
            "description": "null untuk seri level pack."
          },
          "metric": {
            "$ref": "#/components/schemas/HistoryMetric"
          },
          "unit": {
            "type": "string",
            "enum": [
              "C",
              "A",
              "W",
              "V"
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryPoint"
            }
          }
        },
        "required": [
          "scope",
          "packIndex",
          "cellIndex",
          "metric",
          "unit",
          "points"
        ]
      },
      "HistoryMetric": {
        "type": "string",
        "enum": [
          "temperature",
          "current",
          "power",
          "voltage"
        ]
      },
      "HistoryPoint": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-21T08:15:00.000Z",
            "description": "Awal bucket (UTC). Untuk raw: waktu sampel."
          },
          "v": {
            "type": "number",
            "description": "Nilai (raw) atau rata-rata bucket."
          },
          "min": {
            "type": "number",
            "nullable": true,
            "description": "Minimum bucket; null untuk raw."
          },
          "max": {
            "type": "number",
            "nullable": true,
            "description": "Maksimum bucket; null untuk raw."
          }
        },
        "required": [
          "t",
          "v",
          "min",
          "max"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Operasional"
        ],
        "summary": "Health check",
        "description": "Tanpa autentikasi. 200 untuk `ok`/`degraded`, 503 untuk `down`/`shutting_down`. Tidak berisi data sensitif. Bukan bagian dari versi API v1.",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "DB hidup (MQTT mungkin terputus = degraded)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL: kesalahan server (sertakan requestId saat melapor)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "description": "Email + password -> access token (JWT, ±15 menit) dan refresh token (opaque, 30 hari, sekali pakai). Batas: 10 percobaan/15 menit per akun dan 30 per IP (429 + Retry-After). Kode khusus: INVALID_CREDENTIALS (401), ACCOUNT_EXPIRED (403).",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token diterbitkan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR / INVALID_JSON: request tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: token hilang/kedaluwarsa/dicabut (atau kredensial salah)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: tidak punya hak pada resource ini",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: tunggu sesuai header Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL: kesalahan server (sertakan requestId saat melapor)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
