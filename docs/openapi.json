            "description": "Batasi ke satu pack.",
            "name": "packIndex",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 300
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000,
              "description": "Hanya untuk raw: maks sampel per halaman (default 1000)."
            },
            "required": false,
            "description": "Hanya untuk raw: maks sampel per halaman (default 1000).",
            "name": "limit",
