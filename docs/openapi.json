{
  "openapi": "3.0.3",
  "info": {
    "title": "Modular Universal BMS API",
    "version": "1.0.0",
    "description": "API backend untuk aplikasi mobile dan web. Panduan lengkap: docs/API-GUIDE.md.\n\nKonvensi: base path `/api/v1`; waktu ISO-8601 UTC; satuan ada di nama field (voltageV, currentA, powerW, temperatureC, cellDeltaMv);\nerror seragam `{ error: { code, message, details? }, requestId }`; tidak ada SoC/SoH (belum ada di payload perangkat)."
  },
  "servers": [
    {
      "url": "https://YOUR-HOST",
      "description": "Ganti dengan origin publik backend (HTTPS wajib untuk build rilis mobile)"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Token akses + refresh dengan rotasi"
    },
    {
      "name": "Akun",
      "description": "Profil user"
    },
    {
      "name": "Device",
      "description": "Daftar dan detail device, klaim, ubah nama, lepas/hapus"
    },
    {
      "name": "Riwayat",
      "description": "Time-series (raw atau agregat)"
    },
    {
      "name": "Collaborator",
      "description": "Berbagi akses device (viewer/editor)"
    },
    {
      "name": "Dashboard",
      "description": "Ringkasan lintas device"
    },
    {
      "name": "Operasional",
      "description": "Health check"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token dari POST /api/v1/auth/login atau /refresh."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "down",
              "shutting_down"
            ]
          },
          "uptimeSec": {
            "type": "integer"
          },
          "db": {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "latencyMs": {
                "type": "integer",
                "nullable": true
              }
            },
            "required": [
              "ok",
              "latencyMs"
            ]
          },
          "mqtt": {
            "type": "object",
            "properties": {
              "connected": {
                "type": "boolean"
              },
              "lastMessageAt": {
                "type": "string",
                "nullable": true,
                "format": "date-time",
                "example": "2026-09-21T08:15:00.000Z"
              },
              "lastMessageAgeSec": {
                "type": "integer",
                "nullable": true
              }
            },
            "required": [
              "connected",
              "lastMessageAt",
              "lastMessageAgeSec"
            ]
          },
          "ingest": {
            "type": "object",
            "properties": {
              "queueDepth": {
                "type": "integer"
              }
            },
            "required": [
              "queueDepth"
            ]
          },
          "counters": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "status",
          "uptimeSec",
          "db",
          "mqtt",
          "ingest",
          "counters"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "DEVICE_NOT_FOUND",
                "description": "Kode stabil untuk mesin; jangan mem-branch pada `message`."
              },
              "message": {
                "type": "string",
                "description": "Pesan untuk manusia (bahasa Indonesia)."
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ErrorIssue"
                },
                "description": "Hanya untuk VALIDATION_ERROR: daftar isu per field."
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "requestId": {
            "type": "string",
            "description": "Sama dengan header X-Request-Id; sertakan saat melaporkan masalah."
          }
        },
        "required": [
          "error",
          "requestId"
        ]
      },
      "ErrorIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT, kirim sebagai `Authorization: Bearer …`. Simpan HANYA di memori."
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque, sekali pakai (rotasi). Simpan di Keychain/Keystore."
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "description": "Umur access token dalam detik.",
            "example": 900
          },
          "refreshExpiresIn": {
            "type": "integer",
            "description": "Umur refresh token dalam detik.",
            "example": 2592000
          },
          "user": {
            "$ref": "#/components/schemas/Me"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn",
          "refreshExpiresIn",
          "user"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "expiresAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2026-09-21T08:15:00.000Z",
            "description": "Akun berakhir pada waktu ini; null = tidak pernah."
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "expiresAt"
        ]
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "USER",
          "ADMIN"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "deviceName": {
            "type": "string",
            "maxLength": 100,
            "description": "Nama perangkat (mis. 'Pixel 8'), ditampilkan di daftar sesi."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          }
        },
        "required": [
          "refreshToken"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Operasional"
        ],
        "summary": "Health check",
        "description": "Tanpa autentikasi. 200 untuk `ok`/`degraded`, 503 untuk `down`/`shutting_down`. Tidak berisi data sensitif. Bukan bagian dari versi API v1.",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "DB hidup (MQTT mungkin terputus = degraded)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL: kesalahan server (sertakan requestId saat melapor)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "description": "Email + password -> access token (JWT, ±15 menit) dan refresh token (opaque, 30 hari, sekali pakai). Batas: 10 percobaan/15 menit per akun dan 30 per IP (429 + Retry-After). Kode khusus: INVALID_CREDENTIALS (401), ACCOUNT_EXPIRED (403).",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token diterbitkan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR / INVALID_JSON: request tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: token hilang/kedaluwarsa/dicabut (atau kredensial salah)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: tidak punya hak pada resource ini",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: tunggu sesuai header Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL: kesalahan server (sertakan requestId saat melapor)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Perbarui token (rotasi)",
        "description": "Menukar refresh token dengan pasangan baru; refresh token lama LANGSUNG tidak berlaku. Memakai refresh token yang sudah pernah dipakai (REFRESH_REUSED) mencabut SELURUH sesi perangkat itu. Kode 401: INVALID_REFRESH_TOKEN, REFRESH_EXPIRED, REFRESH_REVOKED, REFRESH_REUSED, SESSION_REVOKED — untuk semuanya: hapus token lokal dan minta login ulang. Lakukan refresh dengan SATU permintaan sekaligus (single-flight).",
        "operationId": "refreshToken",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pasangan token baru",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR / INVALID_JSON: request tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: token hilang/kedaluwarsa/dicabut (atau kredensial salah)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: tidak punya hak pada resource ini",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: tunggu sesuai header Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL: kesalahan server (sertakan requestId saat melapor)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout perangkat ini",
        "description": "Mencabut sesi (seluruh rantai refresh token) perangkat ini. Selalu 204 (idempoten). Access token yang sudah terbit tetap berlaku sampai kedaluwarsa (≤ 15 menit): buang dari memori di klien.",
        "operationId": "logout",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Sesi dicabut"
          },
          "400": {
            "description": "VALIDATION_ERROR / INVALID_JSON: request tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: tunggu sesuai header Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL: kesalahan server (sertakan requestId saat melapor)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout dari semua perangkat",
        "description": "Mencabut semua refresh token user dan menaikkan tokenVersion: SEMUA access token (mobile) dan sesi cookie (web) berhenti berlaku seketika.",
        "operationId": "logoutAll",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Semua sesi dicabut"
          },
          "401": {
            "description": "UNAUTHORIZED: token hilang/kedaluwarsa/dicabut (atau kredensial salah)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL: kesalahan server (sertakan requestId saat melapor)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
