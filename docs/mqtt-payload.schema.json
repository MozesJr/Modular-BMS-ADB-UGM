{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "packs": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "temperature": {
            "type": "number",
            "minimum": -60,
            "maximum": 150
          },
          "balancerConnected": {
            "type": "boolean"
          },
          "current": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -1000,
                "maximum": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "power": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              {
                "type": "null"
              }
            ]
          },
          "cells": {
            "minItems": 1,
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "voltage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                }
              },
              "required": [
                "index",
                "voltage"
              ]
            }
          }
        },
        "required": [
          "index",
          "temperature",
          "balancerConnected",
          "cells"
        ]
      }
    }
  },
  "required": [
    "timestamp",
    "packs"
  ]
}
