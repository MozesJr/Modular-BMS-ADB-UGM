# BE/.env.example — development (cp jadi BE/.env). JANGAN taruh nilai asli di file ini; file ini di-commit.
# Semua nilai di bawah adalah PLACEHOLDER.

# Koneksi PostgreSQL. connection_limit membatasi pool Prisma (antrean ingestion memakai INGEST_CONCURRENCY koneksi
# + request REST); 10 cukup untuk satu instance.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public&connection_limit=10

PORT=4000

# Generate: openssl rand -base64 32
# Harus sama persis dengan NEXTAUTH_SECRET di FE/.env.local
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:4000
# Origin publik FE; dipakai untuk tautan di email reset password. Wajib diisi (tanpa ini email reset tidak dikirim).
APP_URL=http://localhost:3001

# MQTT broker (wajib auth di broker produksi)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=CHANGE_ME
MQTT_PASSWORD=CHANGE_ME

# Email reset password (Gmail App Password, BUKAN password akun)
GMAIL_USER=CHANGE_ME@gmail.com
GMAIL_APP_PASSWORD=CHANGE_ME

# --- Opsional ---
# Header berisi IP klien untuk rate limiting. Default x-real-ip (Nginx menimpanya dengan $remote_addr).
# Di belakang Cloudflare Tunnel yang langsung ke BE: cf-connecting-ip. BE tidak boleh terjangkau langsung dari internet.
# RATE_LIMIT_IP_HEADER=x-real-ip

# Antrean ingestion MQTT (nilai default)
# INGEST_CONCURRENCY=4
# INGEST_MAX_PER_DEVICE=20
# INGEST_MAX_TOTAL=2000
