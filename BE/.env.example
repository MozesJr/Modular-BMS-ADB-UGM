# BE/.env.example — development (cp jadi BE/.env). JANGAN taruh nilai asli di file ini; file ini di-commit.
# Semua nilai di bawah adalah PLACEHOLDER.

# Koneksi PostgreSQL. connection_limit membatasi pool Prisma (antrean ingestion memakai INGEST_CONCURRENCY koneksi
# + request REST); 10 cukup untuk satu instance. pool_timeout/connect_timeout menahan resiliensi saat DB diakses
# lewat jalur berlatensi tinggi (mis. SSH tunnel dev) — lihat docs/REDESIGN_PROGRESS.md §diagnosa performa.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public&connection_limit=10&pool_timeout=20&connect_timeout=10

PORT=4000

# Generate: openssl rand -base64 32
# Harus sama persis dengan NEXTAUTH_SECRET di FE/.env.local
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:4000
# Origin publik FE; dipakai untuk tautan di email reset password. Wajib diisi (tanpa ini email reset tidak dikirim).
APP_URL=http://localhost:3001

# MQTT broker (wajib auth di broker produksi)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=CHANGE_ME
MQTT_PASSWORD=CHANGE_ME

# Email reset password (Gmail App Password, BUKAN password akun)
GMAIL_USER=CHANGE_ME@gmail.com
GMAIL_APP_PASSWORD=CHANGE_ME

# Secret access token mobile (JWT). WAJIB, minimal 32 karakter, HARUS BERBEDA dari NEXTAUTH_SECRET.
# Server menolak start bila kosong/pendek/sama. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_base64_48_different_from_nextauth_secret

# --- Opsional ---
# Header berisi IP klien untuk rate limiting. Default x-real-ip (Nginx menimpanya dengan $remote_addr).
# Di belakang Cloudflare Tunnel yang langsung ke BE: cf-connecting-ip. BE tidak boleh terjangkau langsung dari internet.
# RATE_LIMIT_IP_HEADER=x-real-ip

# Antrean ingestion MQTT (nilai default)
# ACCESS_TOKEN_TTL_SEC=900          # umur access token (detik)
# REFRESH_TOKEN_TTL_SEC=2592000     # 30 hari
# REFRESH_FAMILY_MAX_SEC=7776000    # 90 hari: batas absolut sebelum login ulang
# INGEST_CONCURRENCY=4
# INGEST_MAX_PER_DEVICE=20
# INGEST_MAX_TOTAL=2000
# Batas Device baru yang dibuat otomatis dari topik MQTT per jam (0 = mati; hanya serial terdaftar yang diterima)
# PROVISION_MAX_PER_HOUR=20

# --- WebSocket /ws (autentikasi + filter per device) ---
# Origin FE yang boleh membuka /ws (dipisah koma, tanpa path). WAJIB di produksi (server menolak start bila kosong).
# Cookie sesi hanya diterima bila header Origin ada dan terdaftar di sini. Di luar produksi, bila kosong default
# ke http://localhost:3000 dan :3001 (juga 127.0.0.1). Ini env runtime BE (bukan build arg).
# WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# WS_MAX_CONN_PER_USER=5       # koneksi OPEN per user; yang ke-6 ditolak 429
# WS_PING_SEC=30               # heartbeat; koneksi yang tidak membalas pong diputus
# WS_REVALIDATE_SEC=60         # cek ulang sesi ke DB; tidak valid -> close 4401
# WS_MEMBERSHIP_TTL_SEC=60     # jaring pengaman cache keanggotaan device (invalidasi utama lewat mutasi)
