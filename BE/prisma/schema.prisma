generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  emailVerified DateTime?
  role          Role      @default(USER)
  expiresAt     DateTime? // null = tidak pernah expired
  // Naik setiap password diganti/direset atau saat "logout dari semua perangkat".
  // Token (JWT web maupun access token mobile) yang membawa versi lama otomatis ditolak.
  tokenVersion  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  devicesOwned         Device[]              @relation("DeviceOwner")
  deviceCollaborations DeviceCollaborator[]
  passwordResetTokens  PasswordResetToken[]
  refreshTokens        RefreshToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Refresh token mobile (opaque). Hanya HASH yang disimpan; nilai mentah hanya ada di klien.
// Satu login = satu "family"; setiap refresh memutar token (yang lama ditandai usedAt) dan family tetap sama.
// Token yang sudah dipakai lalu dipakai lagi = indikasi pencurian -> seluruh family dicabut.
model RefreshToken {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId        String
  tokenHash       String    @unique // sha256 hex dari token mentah
  tokenVersion    Int // User.tokenVersion saat diterbitkan; beda = sesi dicabut (ganti/reset password, logout-all)
  deviceName      String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  familyExpiresAt DateTime // batas absolut umur family (login ulang setelah ini)
  usedAt          DateTime? // sudah dirotasi
  revokedAt       DateTime?
  replacedById    String?

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Device {
  id            String               @id @default(cuid())
  // serialNumber = device_id dari topik MQTT ("bms/{device_id}/data"), BUKAN PK.
  // Diisi manual oleh user saat daftarin device (ID/lisensi fisik perangkat).
  serialNumber  String               @unique
  name          String?
  // null = device belum diklaim/didaftarin user manapun (auto-provisioned dari ingestion MQTT).
  ownerId       String?
  owner         User?                @relation("DeviceOwner", fields: [ownerId], references: [id])
  verified      Boolean              @default(false)
  // Waktu server terakhir menerima paket MQTT dari device ini — sumber freshness (live/stale/offline).
  lastSeen      DateTime?
  collaborators DeviceCollaborator[]
  createdAt     DateTime             @default(now())
  packs         Pack[]
  packHistory   PackHistory[]
  cellHistory   CellHistory[]
  packRollups   PackRollup1m[]
  cellRollups   CellRollup1m[]

  @@index([ownerId]) // GET /devices: OR(ownerId, collaborators.some(userId))
}

model DeviceCollaborator {
  id       String   @id @default(cuid())
  deviceId String
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("viewer") // viewer | editor
  addedAt  DateTime @default(now())

  @@unique([deviceId, userId])
  @@index([userId])
}

// Latest state per pack — di-upsert tiap message MQTT masuk, buat tampilan real-time.
model Pack {
  id                String   @id @default(cuid())
  index             Int
  deviceId          String
  device            Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  temperature       Float?
  balancerConnected Boolean  @default(false)
  // Nullable: device lama belum kirim field ini di payload MQTT.
  current           Float? // Ampere, dari sensor ACS712-05B — negatif = charging, positif = discharging
  power             Float? // Watt, = voltage_pack x current
  cells             Cell[]
  // Waktu data terakhir yang tersimpan di baris ini (recordedAt hasil resolve, lihat docs/MQTT-CONTRACT.md §3).
  // Dipakai agar pesan yang lebih lama/terlambat tidak menimpa state terbaru. null = baris lama.
  recordedAt        DateTime?
  receivedAt        DateTime? // waktu server menerima pesan MQTT itu
  updatedAt         DateTime @updatedAt

  @@unique([deviceId, index])
}

// Latest state per cell — di-upsert tiap message MQTT masuk, buat tampilan real-time.
model Cell {
  id        String   @id @default(cuid())
  index     Int
  packId    String
  pack      Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  voltage   Float
  updatedAt DateTime @updatedAt

  @@unique([packId, index])
}

// Time-series history per pack, buat grafik tren. Insert baru tiap message MQTT masuk
// (bukan upsert) — satu row per snapshot. Referensi ke Device by id (bukan ke Pack latest-state)
// karena jumlah pack per device dinamis dan row Pack latest-state bisa berubah/hilang.
model PackHistory {
  id                String   @id @default(cuid())
  deviceId          String
  device            Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  packIndex         Int
  temperature       Float?
  balancerConnected Boolean
  current           Float? // Ampere; negatif = charging (null = firmware lama belum mengirim)
  power             Float? // Watt
  recordedAt        DateTime // waktu efektif data: jam device bila wajar, selain itu waktu server (§3 kontrak MQTT)
  receivedAt        DateTime? // waktu server menerima pesan (null = baris lama sebelum kolom ini ada)
  createdAt         DateTime @default(now())

  // Idempotensi: pesan duplikat (redelivery QoS 1) di-skip lewat createMany({ skipDuplicates }).
  @@unique([deviceId, packIndex, recordedAt])
  @@index([deviceId, recordedAt]) // query rentang waktu per device (history, rollup, retensi)
}

// Time-series history per cell, buat grafik tren.
model CellHistory {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  packIndex  Int
  cellIndex  Int
  voltage    Float
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@unique([deviceId, packIndex, cellIndex, recordedAt])
  @@index([deviceId, recordedAt])
}
// Rollup 1 menit dari PackHistory (dibuat oleh scripts/retention.ts). Disimpan avg/min/max + count per metrik supaya bisa
// di-bucket ulang (5m/1h) dengan rata-rata berbobot yang eksak. Raw dihapus setelah 30 hari; rollup disimpan lebih lama.
model PackRollup1m {
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  packIndex    Int
  bucketStart  DateTime // awal menit (UTC)
  samples      Int
  tempAvg      Float?
  tempMin      Float?
  tempMax      Float?
  tempCount    Int      @default(0)
  currentAvg   Float?
  currentMin   Float?
  currentMax   Float?
  currentCount Int      @default(0)
  powerAvg     Float?
  powerMin     Float?
  powerMax     Float?
  powerCount   Int      @default(0)

  @@id([deviceId, packIndex, bucketStart])
}

// Rollup 1 menit dari CellHistory.
model CellRollup1m {
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  packIndex   Int
  cellIndex   Int
  bucketStart DateTime
  samples     Int
  vAvg        Float
  vMin        Float
  vMax        Float

  @@id([deviceId, packIndex, cellIndex, bucketStart])
}
