# BE/.env.production.example — cp jadi BE/.env.production di VPS, isi lalu jangan commit.
# Terpisah dari BE/.env.example (development) karena host/port tujuan berbeda:
# di production BE resolve master_postgresql & bms_mosquitto lewat nama container
# di dalam Docker network "master-db-network" (bukan localhost / IP publik VPS).

# sslmode=disable karena koneksi lewat internal Docker network, bukan lewat internet publik.
DATABASE_URL="postgresql://bms_user:REPLACE_WITH_REAL_PASSWORD@master_postgresql:5432/bms_db?sslmode=disable"

PORT=4000

# Generate baru khusus production: openssl rand -base64 32
# Harus sama persis dengan NEXTAUTH_SECRET di FE/.env.production
NEXTAUTH_SECRET=replace-with-generated-secret

# trustHost:true sudah aktif di BE/src/lib/auth.ts, tapi tetap isi origin publik FE
# sebagai fallback yang benar (BE sendiri tidak diexpose ke publik).
NEXTAUTH_URL=http://REPLACE_WITH_DOMAIN_OR_VPS_IP:3001
# Dipakai buat link di email reset password — origin publik FE juga.
APP_URL=http://REPLACE_WITH_DOMAIN_OR_VPS_IP:3001

RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM="BMS Dashboard <onboarding@resend.dev>"

# Port internal container Mosquitto (1883), BUKAN port host yang dipublish (1885) —
# di dalam Docker network, service lain diakses lewat nama container + port container asli.
MQTT_BROKER_URL="mqtt://bms_mosquitto:1883"
# MQTT_USERNAME="backend_service"
# MQTT_PASSWORD="PASSWORD_BACKEND"

GMAIL_USER=replace-with-gmail-address
GMAIL_APP_PASSWORD=replace-with-gmail-app-password
