# BE/.env.production.example — cp jadi BE/.env.production di VPS, isi lalu jangan commit.
# Terpisah dari .env.example (development): di production BE resolve master_postgresql & bms_mosquitto
# lewat nama container di Docker network "master-db-network" (bukan localhost / IP publik).
# Semua nilai di bawah adalah PLACEHOLDER.

# Tambahkan sslmode=... bila diperlukan. connection_limit membatasi pool Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@master_postgresql:5432/DBNAME?schema=public&connection_limit=10

PORT=4000

# Generate baru khusus production: openssl rand -base64 32
# Harus sama persis dengan NEXTAUTH_SECRET di FE/.env.production
# (Fase B menambah JWT_ACCESS_SECRET yang BERBEDA dari ini untuk token mobile.)
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# trustHost:true sudah aktif di BE/src/lib/auth.ts, tapi tetap isi origin publik FE sebagai fallback.
NEXTAUTH_URL=https://CHANGE_ME.example.com
# Origin publik FE, untuk tautan di email reset password. Wajib.
APP_URL=https://CHANGE_ME.example.com

# Port internal container Mosquitto (1883), BUKAN port host yang dipublish.
MQTT_BROKER_URL=mqtt://bms-mqtt:1883
MQTT_USERNAME=CHANGE_ME
MQTT_PASSWORD=CHANGE_ME

GMAIL_USER=CHANGE_ME@gmail.com
GMAIL_APP_PASSWORD=CHANGE_ME

# --- Opsional ---
# Nginx menimpa X-Real-IP dengan $remote_addr. Bila trafik melewati Cloudflare Tunnel ke Nginx, set di Nginx:
#   set_real_ip_from 127.0.0.1; real_ip_header CF-Connecting-IP;
# supaya $remote_addr = IP pengguna sebenarnya (kalau tidak, semua pengguna berbagi satu bucket rate limit).
# RATE_LIMIT_IP_HEADER=x-real-ip
# INGEST_CONCURRENCY=4
# INGEST_MAX_PER_DEVICE=20
# INGEST_MAX_TOTAL=2000
# Batas Device baru yang dibuat otomatis dari topik MQTT per jam (0 = mati; hanya serial terdaftar yang diterima)
# PROVISION_MAX_PER_HOUR=20
