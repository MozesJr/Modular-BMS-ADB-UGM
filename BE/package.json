{
  "name": "bms-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "next build && tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "start": "node dist/server.js",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mqtt:schema": "tsx scripts/gen-mqtt-schema.ts",
    "test:db": "bash scripts/test-with-db.sh",
    "smoke:web": "bash scripts/with-test-db.sh npx tsx scripts/smoke-web-auth.ts",
    "smoke:web:fe": "bash scripts/smoke-web-with-fe.sh",
    "smoke:container": "bash scripts/smoke-container.sh",
    "openapi": "tsx scripts/gen-openapi.ts",
    "openapi:check": "tsx scripts/gen-openapi.ts --check"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "jose": "^6.2.12",
    "mqtt": "^5.10.1",
    "next": "^15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.5.12",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "prisma": "^5.20.0",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7"
  }
}
