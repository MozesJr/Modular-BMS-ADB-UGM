# BE/.env.development.example — untuk STACK DEV LOKAL (docker-compose.dev.yml).
# Salin jadi BE/.env.development (atau BE/.env saat dev lokal). JANGAN menimpa BE/.env produksi/tunnel.
#
# Postgres lokal di port host 5433 (5432 dipakai SSH tunnel ke VPS).
DATABASE_URL="postgresql://bms_user:devpass@localhost:5433/bms_db?sslmode=disable&connection_limit=10&pool_timeout=20&connect_timeout=10"

PORT=4000
NEXTAUTH_SECRET=dev-nextauth-secret-ganti-sesuka-hati-min-32-char
NEXTAUTH_URL=http://localhost:4000
APP_URL=http://localhost:3000

# Wajib sejak feat/mobile-api-v1 (token access mobile). Minimal 32 karakter, HARUS BEDA dari
# NEXTAUTH_SECRET di atas — server menolak start bila kosong/pendek/sama (lihat lib/env-check.ts).
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-jwt-access-secret-HARUS-BEDA-dari-nextauth-min-32char

# Broker lokal (mosquitto-dev, anonymous). Tanpa username/password.
MQTT_BROKER_URL="mqtt://localhost:1883"
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Email reset password (Gmail App Password, BUKAN password akun). Opsional saat dev — boleh dummy,
# fitur reset password akan gagal terkirim tapi server tetap start.
GMAIL_USER=dev@example.com
GMAIL_APP_PASSWORD=dev-dummy-app-password

# --- WebSocket /ws (autentikasi + filter per device) ---
# Origin FE yang boleh membuka /ws (dipisah koma, tanpa path). WAJIB di produksi (server menolak start bila kosong).
# Cookie sesi hanya diterima bila header Origin ada dan terdaftar di sini. Di luar produksi, bila kosong default
# ke http://localhost:3000 dan :3001 (juga 127.0.0.1). Ini env runtime BE (bukan build arg).
# WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# WS_MAX_CONN_PER_USER=5       # koneksi OPEN per user; yang ke-6 ditolak 429
# WS_PING_SEC=30               # heartbeat; koneksi yang tidak membalas pong diputus
# WS_REVALIDATE_SEC=60         # cek ulang sesi ke DB; tidak valid -> close 4401
# WS_MEMBERSHIP_TTL_SEC=60     # jaring pengaman cache keanggotaan device (invalidasi utama lewat mutasi)

# --- Auto logout idle (web dashboard) ---
# Batas idle sesi web: tanpa interaksi user selama ini, cookie sesi DITOLAK server (REST 401, /ws 401/4401), walau dikirim
# ulang manual. Polling/WebSocket/refetch otomatis bukan aktivitas. Env RUNTIME BE saja: FE menerima nilainya lewat payload
# sesi (tidak ada env/build arg FE). Tidak wajib diisi (default di bawah). API v1 mobile tidak terpengaruh.
# SESSION_IDLE_MINUTES=30
# SESSION_IDLE_WARNING_SECONDS=60   # dialog "Sesi akan berakhir" sebelum batas; harus < SESSION_IDLE_MINUTES x 60
