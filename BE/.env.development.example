# BE/.env.development.example — untuk STACK DEV LOKAL (docker-compose.dev.yml).
# Salin jadi BE/.env.development (atau BE/.env saat dev lokal). JANGAN menimpa BE/.env produksi/tunnel.
#
# Postgres lokal di port host 5433 (5432 dipakai SSH tunnel ke VPS).
DATABASE_URL="postgresql://bms_user:devpass@localhost:5433/bms_db?sslmode=disable&connection_limit=10&pool_timeout=20&connect_timeout=10"

PORT=4000
NEXTAUTH_SECRET=dev-secret-ganti-sesuka-hati
NEXTAUTH_URL=http://localhost:4000
APP_URL=http://localhost:3000

# Broker lokal (mosquitto-dev, anonymous). Tanpa username/password.
MQTT_BROKER_URL="mqtt://localhost:1883"
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Email (opsional saat dev; boleh dummy)
RESEND_API_KEY=re_dev_dummy
EMAIL_FROM="BMS Dev <dev@example.com>"
